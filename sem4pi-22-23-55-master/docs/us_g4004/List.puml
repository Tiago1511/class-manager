@startuml
Actor User as ma
participant AceptRejectMeetingUI as ui  <<presentation>>
participant AceptRejectMeetingController as ctrl <<application>>
participant Meetings <<domain>>
participant AuthorizationService <<service>>
participant ListMeetingsService <<service>>
database MeetingsRepository<<repository>>

activate ma
ma -> ui : list the participants of a meeting
activate ui
ui -> AuthorizationService : see logged in user

ui ->ctrl : choose meeting to react or guest to invite
activate ctrl


ctrl -> ListMeetingsService : get my meetings


activate ListMeetingsService
activate MeetingsRepository
ListMeetingsService -> MeetingsRepository : get my meetings
MeetingsRepository -> ListMeetingsService : meeting list
deactivate MeetingsRepository
ListMeetingsService -> ctrl : meeting list
deactivate ListMeetingsService
ctrl -> ui : meeting list
deactivate ctrl
ui -> ma : show meeting list
deactivate ui
ma -> ui  : choose meeting
activate ui
ui -> ctrl : listMeetings(Meeting)
activate ctrl
ctrl -> Meetings : listGuest(Meeting)
activate Meetings
Meetings -> ctrl : guest list
deactivate Meetings

ctrl -> ui : show meeting participants
deactivate ctrl
ui -> ma : show meeting participants
deactivate ui
deactivate ma
@enduml